# Mailgun (https://app.mailgun.com/) — use a "Private API key"
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Domínio exatamente como no painel Mailgun (muitas vezes mg.seudominio.com, não o site nu)
MAILGUN_DOMAIN=mg.seudominio.com
# Remetente autorizado nesse domínio (ex.: postmaster@mg.seudominio.com ou endereço verificado)
MAILGUN_FROM=Contato Site <noreply@mg.seudominio.com>
# No plano sandbox, só e-mails listados como "Authorized Recipients"
CONTACT_TO_EMAIL=contato@ibiunature.com.br

# EU: defina MAILGUN_REGION=eu ou use MAILGUN_API_BASE abaixo
# MAILGUN_REGION=eu
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# Origem do front Vite (CORS). Produção: URL do site.
FRONTEND_ORIGIN=http://localhost:8080
